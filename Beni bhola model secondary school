<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Beni Bhola Model Secondary School</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f8fc;
      color: #172033;
    }

    header {
      background: #102a43;
      color: white;
      padding: 25px 8%;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    header p {
      opacity: 0.9;
    }

    nav {
      background: white;
      padding: 15px;
      text-align: center;
      box-shadow: 0 2px 10px #0002;
      position: sticky;
      top: 0;
    }

    nav a {
      color: #102a43;
      text-decoration: none;
      margin: 0 12px;
      font-weight: bold;
    }

    nav a:hover {
      color: #e63946;
    }

    .hero {
      padding: 70px 8%;
      text-align: center;
      background: linear-gradient(135deg, #eaf5ff, white);
    }

    .hero h2 {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 19px;
      color: #52616f;
      margin-bottom: 25px;
    }

    .button {
      display: inline-block;
      background: #e63946;
      color: white;
      padding: 12px 22px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    section {
      padding: 55px 8%;
    }

    section h2 {
      font-size: 30px;
      margin-bottom: 25px;
    }

    .teachers,
    .students,
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 5px 20px #0001;
    }

    .card h3 {
      margin-bottom: 8px;
    }

    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 12px;
    }

    .notice {
      background: white;
      padding: 18px;
      margin-bottom: 12px;
      border-left: 5px solid #e63946;
      border-radius: 8px;
    }

    footer {
      background: #102a43;
      color: white;
      text-align: center;
      padding: 25px;
    }

    @media (max-width: 600px) {
      .hero h2 {
        font-size: 32px;
      }

      nav {
        overflow-x: auto;
        white-space: nowrap;
      }

      nav a {
        margin: 0 7px;
      }
    }
  </style>
</head>

<body>

<header>
  <h1>🏫 Shree Beni Bhola Namuna Secondary School</h1>
  <p>Godaita-7, Sarlahi, Nepal</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#about">About</a>
  <a href="#teachers">Teachers</a>
  <a href="#students">Students</a>
  <a href="#gallery">Gallery</a>
  <a href="#notices">Notices</a>
  <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
  <h2>Education • Discipline • Success</h2>
  <p>Welcome to Shree Beni Bhola Namuna Secondary School</p>
  <a class="button" href="#about">Explore School</a>
</section>

<section id="about">
  <h2>About Our School</h2>
  <p>
    Shree Beni Bhola Namuna Secondary School is located at
    Godaita-7, Sarlahi, Nepal. Our school is dedicated to
    education, discipline and the overall development of students.
  </p>
</section>

<section id="teachers">
  <h2>👨‍🏫 Our Teachers</h2>

  <div class="teachers">

    <div class="card">
      <h3>Sunil Sir</h3>
      <p>Teacher</p>
    </div>

    <div class="card">
      <h3>Arvind Sir</h3>
      <p>Teacher</p>
    </div>

    <div class="card">
      <h3>Priyanka Madam</h3>
      <p>Teacher</p>
    </div>

    <div class="card">
      <h3>Sitaram Sir</h3>
      <p>Teacher</p>
    </div>

  </div>
</section>

<section id="students">
  <h2>👨‍🎓 Student Boys Group</h2>

  <div class="students">

    <div class="card">
      <h3>Student Group</h3>
      <p>
        Biki, Phekuu, Amit, Rabi, Manish, Abishek,
        Shivam, Shyam, Ramnath, Ramakanth, Bishnu, etc.
      </p>
    </div>

  </div>
</section>

<section id="gallery">
  <h2>🖼️ School Gallery</h2>

  <div class="gallery">

    <div class="card">
      <img src="school-building.jpg" alt="School Building">
    </div>

    <div class="card">
      <img src="school-group.jpg" alt="School Group">
    </div>

    <div class="card">
      <img src="student-profile.jpg" alt="Student">
    </div>

  </div>
</section>

<section id="notices">
  <h2>📢 Notice Board</h2>

  <div class="notice">
    <h3>Welcome</h3>
    <p>School notices and announcements will appear here.</p>
  </div>

  <div class="notice">
    <h3>New Notice</h3>
    <p>You can add your school announcements here.</p>
  </div>

</section>

<section id="contact">
  <h2>📞 Contact Us</h2>

  <div class="card">
    <p><strong>School:</strong> Shree Beni Bhola Namuna Secondary School</p>
    <p><strong>Address:</strong> Godaita-7, Sarlahi, Nepal</p>
    <p><strong>Phone:</strong> Add school phone number</p>
    <p><strong>Email:</strong> Add school email</p>
  </div>
</section>

<footer>
  <p>
    © 2026 Shree Beni Bhola Namuna Secondary School
  </p>
</footer>

</body>
</html>
